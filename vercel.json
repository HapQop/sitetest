    },
    {
      "source": "/matrixhub",
      "destination": "/pages/matrixhub",
      "permanent": false
    },
    {
      "source": "/mspaint",
      "destination": "/pages/mspaint",
      "permanent": false
    },
    {
      "source": "/pottasium",
      "destination": "/pages/pottasium",
      "permanent": false
    },
    {
      "source": "/privacy-policy",
      "destination": "/pages/privacy-policy",
      "permanent": false
    },
    {
      "source": "/products",
      "destination": "/pages/products",
      "permanent": false
    },
    {
      "source": "/real",
      "destination": "/pages/real",
      "permanent": false
    },
    {
      "source": "/refund-policy",
      "destination": "/pages/refund-policy",
      "permanent": false
